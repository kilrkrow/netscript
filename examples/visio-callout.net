---
title: Visio callout sample
theme: clean-hybrid
---

# Minimal case matching the classic Visio pattern:
# object above tube, straight drop, callout spur intersecting the drop.

inet cloud "Internet" tier wan

dr7 firewall "DR7" tier edge {
  port wan0 "wan0" speed WAN media RJ45
  port eth3 "eth3" speed 1G media RJ45
}

inet -> dr7.wan0 : WAN

segment lan "LAN" subnet 192.168.86.0/24 {
  member dr7.eth3 addr .1
}
