---
title: Home Lab — DR7 (current)
theme: blueprint
---

# Best-guess transcription from the DR7 client snapshot.
# Wired clients are cabled to the switch. Wireless clients carry NO wires —
# they sit in a WLAN container (the Haven SSID on the UDR7 radios).
# Names/IPs are approximate from the screenshot — edit freely in the editor.

wan  cloud    "Internet"            tier wan
dr7  firewall "Dream Router 7"      tier edge mgmt 192.168.1.1
sw1  switch   "USW Pro Max 16-Port" tier core mgmt 192.168.1.2

dr7 -> wan : WAN
dr7 -> sw1 : 10G

rack LAN "Wired" {
  acc    switch  "USW access"        tier tor mgmt 192.168.1.3
  veng   desktop "VENGEANCE (PC)"
  srv    server  "Provision Server"
  shield desktop "NVIDIA Shield"
  bro    desktop "Brother Printer"
  nas    storage "NAS"
}

# WLAN container — no wires; these associate over the air to the Haven SSID.
rack WIFI "WLAN · Haven" {
  echo1  desktop "Echo Dot"
  echo2  desktop "Echo Plus"
  hue    desktop "Philips Hue"
  hedwig desktop "HEDWIG (TP-Link)"
  pixel  desktop "Pixel 9 Pro"
  fold   desktop "Z Fold"
  nuki   desktop "Nuki Lock"
  wyze   desktop "WYZE Cam"
}

# wired cabling only
acc -> sw1 : 10G
veng   -> acc : 1G
srv    -> acc : 10G
shield -> acc : 1G
bro    -> acc : 1G
nas    -> acc : 10G
