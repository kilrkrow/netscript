---
title: Home LAN — Ethernet tubes
theme: clean-hybrid
---

# Visio-style L2 buses: a thick tube per segment, labelled with the class
# (CIDR), plus per-host drops with port/IP bracket callouts on the device side.
# Topology follows NetScript physical tiers (edge → core → ToR → hosts).

rtr firewall "edge-router" tier edge mgmt 192.168.86.1 {
  port lan0 "lan0" speed 1G media RJ45 addr 192.168.86.1/24
  port iot0 "iot0" speed 1G media RJ45 addr 192.168.50.1/24
}

core switch "core-sw" tier core mgmt 192.168.86.2 {
  port te1 "te1" speed 10G
  port te2 "te2" speed 10G
}

rack LAN "Wired hosts" {
  tor switch "access-sw" tier tor mgmt 192.168.86.3 {
    port u1 "u1" speed 10G
    port g1 "g1" speed 1G
    port g2 "g2" speed 1G
    port g3 "g3" speed 1G
    port g4 "g4" speed 1G
  }
  pc  desktop "workstation" {
    port eth0 "eth0" speed 1G media RJ45
  }
  nas storage "nas-01" {
    port eth0 "eth0" speed 1G media RJ45
  }
  cam camera "driveway-cam" {
    port eth0 "eth0" speed 1G media RJ45
  }
  ap  ap "ap-living" {
    port eth0 "eth0" speed 1G media RJ45
  }
}

rtr.lan0 -> core.te1 : 1G
tor.u1 -> core.te2 : 10G
tor.g1 -> pc.eth0 : 1G
tor.g2 -> nas.eth0 : 1G
tor.g3 -> cam.eth0 : 1G
tor.g4 -> ap.eth0 : 1G

# The tube view: one bus per segment, class on the tube, callouts on drops.
segment home "Home LAN" subnet 192.168.86.0/24 {
  member rtr.lan0 addr .1
  member core.te1
  member tor.g1
  member pc.eth0  addr .10
  member nas.eth0 addr .20
  member cam.eth0 addr .40
  member ap.eth0  addr .2
}

segment iot "IoT" subnet 192.168.50.0/24 {
  member rtr.iot0 addr .1
}
