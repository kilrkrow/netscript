---
title: Haven clients — UniFi export (interfaces optional)
theme: clean-hybrid
---

# Generated from UniFi client list (2026-07-29).
# Scan-style: host + addr only — no invented eth0.
# Networks: Default vs iot (UniFi); all IPs on 192.168.86.0/24 in this export.

# Group by UniFi network for readable layout (still no invented interfaces).
rack DEF "Default" {
  vengeance      desktop "VENGEANCE"
  android77      desktop "Android Device"
  mac02e0        desktop "02:e0:4b:6b:2f:5c"
  bc2411         server  "bc:24:11:cf:9e:7f"
  hubx3          desktop "hubx3"
  s380hb         storage "S380HB"
  g7224          desktop "72:24:3b:c9:80:a8"
  proxmox        server  "proxmox.haven"
  smtp           server  "smtp-relay.haven"
  d1293          desktop "12:93:05:c2:a3:5b"
  m0200          desktop "02:00:00:65:3a:94"
  m02a4          desktop "02:a4:27:52:25:4c"
  eefd           desktop "ee:fd:db:d2:8a:a3"
  m3a65          desktop "3a:65:f9:12:59:02"
  baf3           desktop "ba:f3:07:4e:8a:54"
  pbs            server  "pbs"
  ea5e           desktop "ea:5e:af:69:86:ba"
  files          server  "files"
  haven          server  "haven"
  galaxy         desktop "Galaxy-Tab-S7"
  pixel          desktop "Pixel-10-Pro-XL"
  brother        desktop "Brother"
  oculus         desktop "Oculus Go"
  guysfold       desktop "Guy-s-Z-Fold6"
  guytab         desktop "Guy-s-Tab-S9-Ultra"
  wendis         desktop "Wendis-Rockin-Tablet"
  arc02          desktop "Arc-02"
  huebridge      desktop "Hue bridge"
}

rack IOT "iot SSID" {
  lb130          desktop "LB130"
  echo3          desktop "Amazon Echo (3rd)"
  shield         desktop "NVIDIA Shield TV"
  samsung40      desktop "Samsung 40:08"
  echodot2       desktop "Amazon Echo Dot (2nd)"
  hs200a         desktop "HS200 05:2f"
  hs200b         desktop "HS200 dd:af"
  echoflex       desktop "Amazon Echo Flex"
  hs103          desktop "HS103"
  nuki           desktop "Nuki Smart Lock 2"
  espresso       desktop "espresso (WYZE)"
}
# Default network tube (wired + primary Wi‑Fi clients)
segment default "Default" subnet 192.168.86.0/24 {
  member vengeance addr 192.168.86.198
  member android77 addr 192.168.86.104
  member mac02e0   addr 192.168.86.5
  member bc2411    addr 192.168.86.3
  member hubx3     addr 192.168.86.54
  member s380hb    addr 192.168.86.81
  member g7224     addr 192.168.86.19
  member proxmox   addr 192.168.86.2
  member smtp      addr 192.168.86.25
  member d1293     addr 192.168.86.40
  member m0200     addr 192.168.86.8
  member m02a4     addr 192.168.86.42
  member eefd      addr 192.168.86.49
  member m3a65     addr 192.168.86.7
  member baf3      addr 192.168.86.12
  member pbs       addr 192.168.86.230
  member ea5e      addr 192.168.86.9
  member files     addr 192.168.86.53
  member haven     addr 192.168.86.4
  member galaxy    addr 192.168.86.251
  member pixel     addr 192.168.86.123
  member brother   addr 192.168.86.245
  member oculus    addr 192.168.86.221
  member guysfold  addr 192.168.86.168
  member guytab    addr 192.168.86.209
  member wendis    addr 192.168.86.219
  member arc02     addr 192.168.86.127
  member huebridge addr 192.168.86.156
}

# IoT network (same /24 in this export — separate UniFi network / SSID)
segment iot "iot" subnet 192.168.86.0/24 {
  member lb130     addr 192.168.86.95
  member echo3     addr 192.168.86.183
  member shield    addr 192.168.86.102
  member samsung40 addr 192.168.86.141
  member echodot2  addr 192.168.86.21
  member hs200a    addr 192.168.86.73
  member hs200b    addr 192.168.86.101
  member echoflex  addr 192.168.86.93
  member hs103     addr 192.168.86.225
  member nuki      addr 192.168.86.247
  member espresso  addr 192.168.86.171
}
